# -*- coding: utf-8 -*-
# Copyright 2026  Admin AI Team, All rights reserved.
#
# Admin AI Agent 环境变量示例
# 与 app/admin_ai/config.py 的 Settings 字段严格对齐。
# 用法：cp .env.example .env 后按需修改；生产环境禁止直接使用示例默认值。

# ============ 应用配置 ============
APP_NAME=Admin AI Agent
APP_VERSION=0.1.0
# ⚠️ 生产环境必须为 false；DEBUG=true 会输出详细错误与调试信息，存在信息泄露风险
DEBUG=false

# ============ 服务器配置 ============
HOST=0.0.0.0
PORT=8000

# ============ CORS 配置 ============
# 多个域名用英文逗号分隔；值为 JSON 数组格式。
# ⚠️ 生产环境禁止使用 ["*"]，必须显式列出受信域名，例如：
# CORS_ORIGINS=["https://admin.example.com","https://oa.example.com"]
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# ============ 数据库配置 ============
# PostgreSQL 连接字符串（异步驱动 asyncpg）
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/admin_ai

# ============ Redis 配置 ============
REDIS_URL=redis://localhost:6379/0

# ============ LLM 配置 ============
OPENAI_API_KEY=sk-your-api-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0

# ============ 向量数据库配置 ============
CHROMA_HOST=localhost
# 宿主端口用 8005，避免与 OA_SERVICE_URL 的 8001 冲突
CHROMA_PORT=8005

# ============ 外部服务配置 ============
OA_SERVICE_URL=http://localhost:8001
FINANCE_SERVICE_URL=http://localhost:8002
MATERIAL_SERVICE_URL=http://localhost:8003

# ============ SSO 配置 ============
SSO_ENABLED=false
SSO_URL=

# ============ 飞书 OAuth 配置 ============
FEISHU_APP_ID=your-feishu-app-id
FEISHU_APP_SECRET=your-feishu-app-secret
FEISHU_REDIRECT_URI=http://localhost:8000/api/v1/auth/feishu/callback

# ============ 安全配置 ============
# ⚠️ 生产环境必须替换为高强度随机值（如 openssl rand -hex 32）；
#    应用应在启动时检测到默认值时 fail-fast，拒绝启动。
SECRET_KEY=your-random-secret-key-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ============ 限流配置 ============
RATE_LIMIT_DEFAULT=100/minute

# ============ 日志配置 ============
LOG_LEVEL=INFO

# ============ Celery 配置 ============
# 注意：CELERY_BROKER_URL / CELERY_RESULT_BACKEND 已在 config.py 的 Settings 中定义，
# 当前由 Celery 任务模块单独读取使用。
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
