# Admin AI Agent 环境变量配置

# ============ 应用配置 ============
APP_NAME=Admin AI Agent
APP_VERSION=1.0.0
DEBUG=true

# ============ 服务器配置 ============
HOST=0.0.0.0
PORT=8000

# ============ CORS 配置 ============
# 多个域名用逗号分隔
CORS_ORIGINS=["*"]

# ============ 数据库配置 ============
# PostgreSQL 连接字符串
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/admin_ai

# ============ Redis 配置 ============
REDIS_URL=redis://localhost:6379/0

# ============ LLM 配置 ============
# OpenAI API
OPENAI_API_KEY=sk-your-api-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0

# ============ 向量数据库配置 ============
# ChromaDB
CHROMA_HOST=localhost
CHROMA_PORT=8000

# ============ 外部服务配置 ============
# OA 系统
OA_SERVICE_URL=http://localhost:8001

# 财务系统
FINANCE_SERVICE_URL=http://localhost:8002

# 物资管理系统
MATERIAL_SERVICE_URL=http://localhost:8003

# ============ SSO 配置 ============
SSO_ENABLED=false
SSO_URL=

# ============ 安全配置 ============
SECRET_KEY=your-random-secret-key-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ============ 限流配置 ============
RATE_LIMIT_DEFAULT=100/minute

# ============ 日志配置 ============
LOG_LEVEL=INFO

# ============ Celery 配置 ============
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2